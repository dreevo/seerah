# Copy to `.env` on the EC2 box and fill in.  Never commit the real .env.
# Used by docker-compose.aws.yml (external RDS database; semantic search on).

# --- RDS Postgres (from the RDS console; keep it private to the EC2 security group) ---
# Endpoint looks like: seerah.xxxxxxxx.<region>.rds.amazonaws.com
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/seerah?sslmode=require
DB_USER=seerah
DB_PASSWORD=your-rds-master-password

# --- Public site (an A record for this domain must point at the EC2 Elastic IP) ---
SITE_DOMAIN=seerah.example.com
ACME_EMAIL=you@example.com
