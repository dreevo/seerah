# Copy to `.env` and fill in.  Never commit the real .env.

# --- Postgres (internal to the compose network; not exposed publicly) ---
DB_USER=seerah
DB_PASSWORD=change-me-to-a-long-random-string
DB_NAME=seerah

# --- Public site ---
# An A record for this domain must point at the VM's public IP before you start,
# or Caddy cannot obtain a certificate.
SITE_DOMAIN=seerah.example.com
# Used by Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com
