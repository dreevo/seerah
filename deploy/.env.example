# Copy to `.env` and fill in.  Never commit the real .env.

# --- Postgres (internal to the compose network; not exposed publicly) ---
DB_USER=seerah
DB_PASSWORD=change-me-to-a-long-random-string
DB_NAME=seerah

# --- Public site ---
# An A record for this domain must point at the VM's public IP before you start,
# or Caddy cannot obtain a certificate.
SITE_DOMAIN=seerah.example.com
# Used by Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com

# --- Sizing (defaults suit a roomy VM like Oracle A1) ---
# Roomy host (Oracle A1, >=2 GB): keep semantic search on with the defaults below.
# Tiny host (AWS t3.micro, 1 GB): uncomment the three overrides to fit memory —
# keyword search instead of the 86 MB model, smaller heap, smaller container.
# SEERAH_SEARCH_SEMANTIC=false
# JAVA_OPTS=-XX:MaxRAMPercentage=70
# BACKEND_MEM=750m
